{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/telemetry-hook.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(date -u *)",
      "Bash(xcodebuild *)",
      "Bash(bash scripts/telemetry-hook.sh*)",
      "Bash(bash scripts/agent-log.sh*)",
      "Bash(just test*)",
      "Bash(just build-mac*)",
      "Bash(just install*)",
      "Bash(just pr-list*)",
      "Bash(just ci *)",
      "Bash(just log *)",
      "Bash(direnv allow*)",
      "Bash(xcodegen *)",
      "Bash(DEVELOPER_DIR=* xcodebuild *)",
      "Bash(set -o pipefail && DEVELOPER_DIR=* xcodebuild *)",
      "Bash(bash scripts/install-mac.sh*)",
      "Bash(just --list*)",
      "Bash(git push *)",
      "Bash(bash /Users/*/scripts/install-mac.sh*)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh run view *)",
      "Bash(gh help *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh repo view *)"
    ]
  }
}
