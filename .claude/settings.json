{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/telemetry-hook.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(date -u *)",
      "Bash(xcodebuild *)",
      "Bash(bash scripts/telemetry-hook.sh*)",
      "Bash(bash scripts/agent-log.sh*)",
      "Bash(just test*)",
      "Bash(just build-mac*)",
      "Bash(just install*)",
      "Bash(just pr-list*)",
      "Bash(just ci *)",
      "Bash(just log *)",
      "Bash(direnv allow*)",
      "Bash(xcodegen *)",
      "Bash(DEVELOPER_DIR=* xcodebuild *)",
      "Bash(set -o pipefail && DEVELOPER_DIR=* xcodebuild *)",
      "Bash(bash scripts/install-mac.sh*)",
      "Bash(export PATH=* && gh pr checks *)",
      "Bash(export PATH=* && gh run list *)",
      "Bash(export PATH=* && gh run watch *)",
      "Bash(export PATH=* && gh help *)",
      "Bash(just --list*)",
      "Bash(git push *)",
      "Bash(bash /Users/*/scripts/install-mac.sh*)",
      "Bash(export PATH=* DEVELOPER_DIR=* && just test*)",
      "Bash(export PATH=* DEVELOPER_DIR=* && just pr-list*)",
      "Bash(export PATH=* && direnv allow*)"
    ]
  }
}
