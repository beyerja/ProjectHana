{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/permission-capture-hook.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/telemetry-hook.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(date -u *)",
      "Bash(xcodebuild *)",
      "Bash(bash scripts/telemetry-hook.sh*)",
      "Bash(bash scripts/permission-capture-hook.sh*)",
      "Bash(bash scripts/agent-log.sh*)",
      "Bash(just test*)",
      "Bash(just build-mac*)",
      "Bash(just install*)",
      "Bash(just pr-list*)",
      "Bash(just ci *)",
      "Bash(just log *)",
      "Bash(just telemetry*)",
      "Bash(just telemetry-history*)",
      "Bash(just lint*)",
      "Bash(just --dry-run lint*)",
      "Bash(just --dry-run test*)",
      "Bash(just --dry-run build-mac*)",
      "Bash(just --dry-run install*)",
      "Bash(just --dry-run pr-list*)",
      "Bash(just --dry-run ci *)",
      "Bash(just --dry-run log *)",
      "Bash(just --dry-run telemetry*)",
      "Bash(just --dry-run telemetry-history*)",
      "Bash(direnv allow*)",
      "Bash(xcodegen *)",
      "Bash(DEVELOPER_DIR=* xcodebuild *)",
      "Bash(set -o pipefail && DEVELOPER_DIR=* xcodebuild *)",
      "Bash(bash scripts/install-mac.sh*)",
      "Bash(just --list*)",
      "Bash(just --evaluate*)",
      "Bash(git push *)",
      "Bash(git worktree *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(bash /Users/*/scripts/install-mac.sh*)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh run view *)",
      "Bash(gh help *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh repo view *)",
      "Bash(python3 scripts/telemetry-summary.py*)",

      "Bash(tail *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(cut *)",
      "Bash(comm *)",
      "Bash(uniq *)",
      "Bash(nl *)",
      "Bash(column *)",
      "Bash(jq *)",
      "Bash(sleep *)",
      "Bash(grep -r *)",

      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* status*)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* add *)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* commit -F *)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* push*)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* log*)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* diff*)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* show*)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* checkout *)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* switch *)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* merge *)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* fetch*)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* branch*)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* check-ignore *)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* rev-parse *)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* ls-files*)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* restore *)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* stash*)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* mv *)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* rm *)",
      "Bash(git -C /Users/Private/Documents/Code/ProjectHana-worktrees/* worktree *)",

      "Bash(scripts/gh-review-bot.sh:*)"
    ]
  }
}
