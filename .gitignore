# Xcode
*.xcuserstate
.build-mac/
*.xcscmblueprint
xcuserdata/
DerivedData/
build/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# direnv (flake dev-shell cache)
.direnv/

# Python (helper scripts in scripts/; linted with ruff)
__pycache__/
*.pyc

# Swift Package Manager
.build/
.swiftpm/
# Note: Package.resolved is intentionally committed to pin dependencies
# *.resolved

# macOS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# CocoaPods (not used, but guard against accidental addition)
Pods/
Podfile.lock

# Workflow telemetry (local only, never committed)
.workflow/telemetry/*.jsonl

# Workflow screenshots (binary, large, local only)
.workflow/screenshots/

# Workflow live working state (local only — each worktree owns its own).
# Only the durable, date+slug-namespaced archive/ and README.md are tracked, so
# parallel feature workflows in separate worktrees never collide on this state.
.workflow/feature.md
.workflow/stories.md
.workflow/log.md
.workflow/stories/
# Keep the durable record and docs tracked:
!.workflow/archive/
!.workflow/README.md

# UI-walkthrough driver: ignore per-run artifact dirs (screenshots + element dumps),
# but keep the committed action scripts and the authoring README tracked.
.workflow/ui-walkthrough/*
!.workflow/ui-walkthrough/scripts/
!.workflow/ui-walkthrough/scripts/**
!.workflow/ui-walkthrough/README.md
